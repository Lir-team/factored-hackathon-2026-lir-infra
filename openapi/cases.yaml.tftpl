# OpenAPI 2.0 spec of the case flow gateway, rendered by gateway.tf.
swagger: "2.0"
info:
  title: ${title}
  description: Public entry of the Lir case flow (lir-web form and Telegram webhook).
  version: "1.0.0"
schemes:
  - https
produces:
  - application/json

# allowCors passes CORS requests, preflights included, through to the service, which
# answers them for CORS_ORIGINS. The name must be the API's managed service.
x-google-endpoints:
  - name: ${managed_service}
    allowCors: true

# Every route goes to the cases service, signed with an ID token of the gateway's service
# account (the service only admits invokers). The path is appended to the address.
x-google-backend:
  address: ${backend_address}
  jwt_audience: ${backend_address}
  path_translation: APPEND_PATH_TO_ADDRESS
  # The Telegram webhook runs an agent turn (an LLM call) before answering.
  deadline: 60.0

securityDefinitions:
  # lir-web sends the key as ?key=<cases_api_key>.
  api_key:
    type: apiKey
    name: key
    in: query
%{ if customer_sign_in ~}
  # The customer's JWT from the bank's sign-in (Authorization: Bearer). API Gateway verifies
  # it against the issuer's published keys and forwards its claims to the service.
  customer_jwt:
    type: oauth2
    flow: implicit
    authorizationUrl: ""
    x-google-issuer: "${jwt_issuer}"
    x-google-jwks_uri: "${jwt_jwks_uri}"
    x-google-audiences: "${jwt_audience}"
%{ endif ~}

paths:
  /v1/cases:
    post:
      operationId: submitCase
      summary: File a case from the lir-web form.
      security:
        - api_key: []
%{ if customer_sign_in ~}
          customer_jwt: []
%{ endif ~}
      responses:
        "202":
          description: Case accepted; the body carries the folio and the Telegram start link.
        default:
          description: Error answered by the agent.
    options:
      operationId: submitCasePreflight
      summary: CORS preflight, answered by the service (no API key, browsers send none).
      responses:
        "200":
          description: CORS headers for the allowed origins.
  # The signed-in customer's latest transactions for lir-web; the customer comes from the JWT.
  /v1/me/transactions:
    get:
      operationId: listMyTransactions
      summary: The signed-in customer's latest transactions (lir-web statement).
      parameters:
        - name: limit
          in: query
          required: false
          type: integer
      security:
        - api_key: []
%{ if customer_sign_in ~}
          customer_jwt: []
%{ endif ~}
      responses:
        "200":
          description: The customer and their transactions, newest first.
        default:
          description: Error answered by the agent.
    options:
      operationId: listMyTransactionsPreflight
      summary: CORS preflight, answered by the service.
      responses:
        "200":
          description: CORS headers for the allowed origins.
  # Approval card (human in the loop): the single-use link token travels in
  # X-Approval-Token; with customer_sign_in, the customer must also be signed in (step-up).
  /v1/approvals/{approval_id}:
    parameters:
      - name: approval_id
        in: path
        required: true
        type: string
    get:
      operationId: getApproval
      summary: The approval card behind a customer's single-use link.
%{ if customer_sign_in ~}
      security:
        - customer_jwt: []
%{ endif ~}
      responses:
        "200":
          description: The request, in the customer's language.
        default:
          description: Error answered by the agent.
    options:
      operationId: getApprovalPreflight
      summary: CORS preflight, answered by the service.
      responses:
        "200":
          description: CORS headers for the allowed origins.
  /v1/approvals/{approval_id}/decision:
    parameters:
      - name: approval_id
        in: path
        required: true
        type: string
    post:
      operationId: decideApproval
      summary: The customer approves or rejects from the approval card.
%{ if customer_sign_in ~}
      security:
        - customer_jwt: []
%{ endif ~}
      responses:
        "200":
          description: The decision, and what ran.
        default:
          description: Error answered by the agent.
    options:
      operationId: decideApprovalPreflight
      summary: CORS preflight, answered by the service.
      responses:
        "200":
          description: CORS headers for the allowed origins.
  /channels/telegram:
    post:
      operationId: telegramWebhook
      summary: Telegram Bot API webhook; the agent checks X-Telegram-Bot-Api-Secret-Token.
      responses:
        "200":
          description: Update handled.
        default:
          description: Error answered by the agent; Telegram retries the update.
